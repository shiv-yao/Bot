# BTC 5-minute Balanced HF Paper profile
LIVE_TRADING=false
AUTO_DISCOVER_MARKET=true
FORCE_BTC_5M_MARKET=true
MARKET_SLUG_PREFIX=btc-updown-5m-
MARKET_INTERVAL_SEC=300
MARKET_DISCOVERY_REFRESH_SEC=3

PAPER_HIGH_FREQUENCY_PROFILE=true
PAPER_HF_MAX_ORDER_EQUITY_FRACTION=0.0025
PAPER_HF_MAX_DAILY_LOSS_FRACTION=0.02
PAPER_HF_MAX_OPEN_NOTIONAL_USD=30

MIN_EDGE=0.02
MIN_NET_EDGE=0.008
MIN_CONFIDENCE=0.56
AI_MIN_PROBABILITY_MARGIN=0.006
MAX_SPREAD=0.04
SIGNAL_COOLDOWN_MS=500
STRATEGY_EVALUATION_INTERVAL_MS=75
MIN_DEPTH_MULTIPLE=1.5
MAX_SLIPPAGE=0.015
SLIPPAGE_BUFFER=0.003

MAX_QUEUE_SIZE=2000
EXECUTION_WORKERS=4
PAPER_DISABLE_ORDER_RATE_LIMIT=true

PAPER_HOLD_SEC=30
PAPER_MARK_INTERVAL_SEC=0.5
PAPER_TAKE_PROFIT_PCT=0.035
PAPER_STOP_LOSS_PCT=0.02
PAPER_TRAILING_STOP_PCT=0.02
PAPER_OPEN_BUFFER_SEC=3
PAPER_CLOSE_BUFFER_SEC=15
PAPER_MAX_TRADES_PER_MARKET=0
PAPER_MAX_OPEN_POSITIONS=0
PAPER_MAX_CONSECUTIVE_LOSSES_PER_MARKET=4

# Keep old history untouched. The runtime profile also enforces this path in Paper mode.
PAPER_DB_PATH=/data/polymarket_paper_btc5m_balanced.db
