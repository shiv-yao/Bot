# Safe external integration settings for BTC 5m V4 Hardened.
# These settings never enable live orders or wallet signing.

# -----------------------------------------------------------------------------
# warproxxx/poly_data GPL-3.0 pipeline: independent read-only sidecar boundary.
# -----------------------------------------------------------------------------
# Recommended Railway layout:
#   Service A: existing BTC 5m V4 bot
#   Service B: deploy/poly_data_sidecar/Dockerfile with its own dedicated volume
# Service A reads Service B's /manifest endpoint only. GPL upstream code is not
# copied or imported into the BTC 5m runtime.
POLY_DATA_SIDECAR_ENABLED=false
POLY_DATA_SIDECAR_MANIFEST_URL=
# Optional shared secret. Use the same random value in both services.
POLY_DATA_SIDECAR_MANIFEST_TOKEN=
POLY_DATA_SIDECAR_TIMEOUT_SEC=3
POLY_DATA_MAX_STALE_SEC=900

# Optional fallback local-files mode. Use only when a generated-data folder is
# mounted or synchronized into the BTC 5m service. Remote manifest mode is safer
# for Railway because each service can use its own volume.
POLY_DATA_SIDECAR_ROOT=/data/poly_data
POLY_DATA_MARKETS_PATH=/data/poly_data/data/markets.csv
POLY_DATA_ORDERS_PATH=/data/poly_data/data/orderFilled.csv
POLY_DATA_TRADES_PATH=/data/poly_data/processed/trades.csv
POLY_DATA_CURSOR_PATH=/data/poly_data/data/cursor_state.json

# Sidecar service only. It controls upstream update cadence and Polygon scans.
POLY_DATA_UPDATE_INTERVAL_SEC=300
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_MAX_BLOCK_RANGE=5
PROCESS_CHUNK_SIZE=0

# -----------------------------------------------------------------------------
# warproxxx/poly-maker concepts: observational Paper-only shadow diagnostics.
# -----------------------------------------------------------------------------
# No upstream trading client, private key, Google credentials or order executor
# is imported. The module reads the existing BTC 5m order books only.
POLY_MAKER_SHADOW_ENABLED=true
POLY_MAKER_SHADOW_MAX_BOOK_AGE_MS=5000
POLY_MAKER_SHADOW_MIN_SPREAD=0.01
POLY_MAKER_SHADOW_MIN_DEPTH_USD=20
POLY_MAKER_SHADOW_QUOTE_TICK=0.01
POLY_MAKER_SHADOW_MERGE_MIN_SHARES=5

# -----------------------------------------------------------------------------
# BTC 5m SQLite history retention. This helps protect the Railway bot-volume.
# -----------------------------------------------------------------------------
BTC5M_STORAGE_RETAIN_ROUNDS=2500
BTC5M_STORAGE_MAINTENANCE_INTERVAL_SEC=900
BTC5M_STORAGE_VACUUM_MIN_DELETED_ROWS=100
BTC5M_STORAGE_VACUUM_MIN_INTERVAL_SEC=21600
