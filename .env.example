# Safe default: paper trading. This branch intentionally runs paper mode only.
APP_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Polymarket market data
CLOB_HOST=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
CHAIN_ID=137
PK=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
SIGNATURE_TYPE=0
FUNDER_ADDRESS=

# Manual market IDs are optional while AUTO_DISCOVER_MARKET=true.
YES_TOKEN_ID=
NO_TOKEN_ID=
CONDITION_ID=
TICK_SIZE=0.01
NEG_RISK=false

# Automatic BTC Up/Down 5-minute market discovery and rotation.
AUTO_DISCOVER_MARKET=true
FORCE_BTC_5M_MARKET=true
MARKET_SLUG_PREFIX=btc-updown-5m-
MARKET_INTERVAL_SEC=300
MARKET_DISCOVERY_REFRESH_SEC=3
MARKET_DISCOVERY_TIMEOUT_SEC=3

# Conservative baseline limits. Live mode always uses these values.
LIVE_TRADING=false
LIVE_CONFIRMATION=
ACCOUNT_EQUITY_USD=1000
MAX_ORDER_EQUITY_FRACTION=0.005
MAX_DAILY_LOSS_FRACTION=0.005
MAX_OPEN_NOTIONAL_USD=10

# Paper-only high-frequency profile. It never applies to Live mode.
PAPER_HIGH_FREQUENCY_PROFILE=true
PAPER_HF_MAX_ORDER_EQUITY_FRACTION=0.0025
PAPER_HF_MAX_DAILY_LOSS_FRACTION=0.02
PAPER_HF_MAX_OPEN_NOTIONAL_USD=100

# AI single-direction YES / NO filters tuned for faster Paper sampling.
MIN_EDGE=0.012
MIN_NET_EDGE=0.004
MIN_CONFIDENCE=0.52
AI_MIN_PROBABILITY_MARGIN=0.003
MIN_CONTRACT_PRICE=0.10
MAX_CONTRACT_PRICE=0.90
MAX_SPREAD=0.06
SIGNAL_COOLDOWN_MS=250
MAX_SIGNAL_AGE_MS=1200
STRATEGY_EVALUATION_INTERVAL_MS=50
PREFER_FUSION_PREDICTION=true

# Order Book depth, VWAP and slippage simulation.
DEPTH_LEVELS=5
MIN_DEPTH_MULTIPLE=1.25
MAX_SLIPPAGE=0.03
SLIPPAGE_BUFFER=0.002

# Execution controls.
ORDER_TIMEOUT_MS=1500
MAX_QUEUE_SIZE=5000
EXECUTION_WORKERS=8
ORDER_RATE_PER_SEC=10
ORDER_BURST=20
# Disable Token Bucket only for PaperExecutor. LiveExecutor keeps rate limiting enabled.
PAPER_DISABLE_ORDER_RATE_LIMIT=true

# Hardened Paper portfolio simulation.
PAPER_HOLD_SEC=20
# Set to 0 to disable the Paper open-position-count cap.
PAPER_MAX_OPEN_POSITIONS=0
PAPER_MARK_INTERVAL_SEC=0.25
PAPER_TAKE_PROFIT_PCT=0.025
PAPER_STOP_LOSS_PCT=0.02
PAPER_TRAILING_STOP_PCT=0.015
PAPER_OPEN_BUFFER_SEC=2
PAPER_CLOSE_BUFFER_SEC=10
# Set to 0 to disable the per-market trade-count cap.
PAPER_MAX_TRADES_PER_MARKET=0
PAPER_MAX_CONSECUTIVE_LOSSES_PER_MARKET=8

# BTC 5m review settings. Adaptive cooldown is intentionally disabled.
# Loss streaks remain visible in analytics but do not pause new Paper evaluations.
BTC5M_PAPER_ADAPTIVE_COOLDOWN_ENABLED=false
BTC5M_PAPER_COOLDOWN_AFTER_LOSSES=3
BTC5M_PAPER_COOLDOWN_SEC=900
# Split analytics remain observational until enough Paper samples exist.
BTC5M_PAPER_ANALYTICS_MIN_SAMPLES=30
BTC5M_PAPER_REVIEW_MIN_GROUP_SAMPLES=10
BTC5M_PAPER_REVIEW_WIN_RATE_THRESHOLD=0.45
BTC5M_PAPER_ROLLING_WINDOW=30
BTC5M_PAPER_CALIBRATION_MIN_BUCKET_SAMPLES=10
BTC5M_PAPER_OVERCONFIDENCE_GAP_THRESHOLD=0.10
BTC5M_PAPER_DRIFT_MIN_SAMPLES=20
BTC5M_PAPER_DRIFT_WIN_RATE_DROP_THRESHOLD=0.15
BTC5M_PAPER_DRIFT_BRIER_INCREASE_THRESHOLD=0.10
BTC5M_PAPER_WALK_FORWARD_TRAIN_MIN_SAMPLES=30
BTC5M_PAPER_WALK_FORWARD_VALIDATION_SAMPLES=20
BTC5M_PAPER_WALK_FORWARD_WIN_RATE_DROP_THRESHOLD=0.10
BTC5M_PAPER_WALK_FORWARD_BRIER_INCREASE_THRESHOLD=0.05

# BTC 5m V4 Hardened quality gates.
BTC5M_PAPER_OPEN_PRICE_MAX_DELAY_MS=2000
BTC5M_PAPER_SETTLEMENT_MAX_DELAY_MS=2000
BTC5M_PAPER_STAGE_CONFIRM_SAMPLES=1,3,5
BTC5M_PAPER_STAGE_CONFIRM_WINDOW_SEC=0,8,15
BTC5M_PAPER_STAGE_MAX_DIRECTION_FLIPS=0,0,0
BTC5M_PAPER_SCALE_IN_MAX_PRICE_WORSENING=0,0.025,0.015
BTC5M_PAPER_SCALE_IN_MAX_EDGE_DECAY=0,0.004,0.002
# Stage 1 may use a fresh RTDS fallback. Stages 2 and 3 remain strict.
BTC5M_PAPER_STAGE_MIN_CLEAN_SOURCES=0,2,3
BTC5M_PAPER_STAGE_REQUIRE_FUSION=false,true,true
BTC5M_PAPER_STAGE_MIN_BOOK_IMBALANCE=0.20,0.30,0.35
# Observational only. Shadow A/B never creates extra Paper positions.
BTC5M_PAPER_SHADOW_AB_ENABLED=true

# Paper history persistence. Attach a Railway volume at /data for durable history.
PAPER_DB_PATH=/data/polymarket_paper.db
RECENT_TRADE_LIMIT=100

# Polymarket Chainlink RTDS.
MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
RTDS_WS_URL=wss://ws-live-data.polymarket.com
ENABLE_RTDS_MOMENTUM_PREDICTION=true
RTDS_PREDICTION_WINDOW_SEC=20

# Public external BTC spot market feeds.
ENABLE_BINANCE_WS=true
ENABLE_COINBASE_WS=true
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
BINANCE_WS_FALLBACK_URLS=wss://stream.binance.com:443/ws/btcusdt@trade,wss://data-stream.binance.vision/ws/btcusdt@trade
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
SOURCE_RECONNECT_DELAY_SEC=1
SOURCE_RECONNECT_MAX_DELAY_SEC=30
EXTERNAL_PRICE_MAX_AGE_MS=3000
EXTERNAL_PRICE_WINDOW_SEC=20

# Multi-source fusion.
ENABLE_MULTI_SOURCE_FUSION=true
FUSION_MIN_SOURCES=2
FUSION_AGREEMENT_THRESHOLD=0.55
FUSION_PROBABILITY_SCALE=40
FUSION_BASE_CONFIDENCE=0.52
FUSION_SOURCE_WEIGHT_CHAINLINK=1.0
FUSION_SOURCE_WEIGHT_BINANCE=1.0
FUSION_SOURCE_WEIGHT_COINBASE=1.0
# Exclude one BTC source when its latest price deviates too far from the cross-source median.
FUSION_OUTLIER_MAX_DEVIATION_BPS=35
# Block new fusion predictions when the remaining clean sources still disagree too much.
FUSION_MAX_DISPERSION_BPS=20

# Short-horizon regime filter. Reject low-information and unstable samples.
FUSION_REGIME_FILTER_ENABLED=true
FUSION_REGIME_WINDOW_SEC=12
FUSION_REGIME_MIN_SAMPLES=5
# Reject abrupt short-window moves that are too unstable for guarded scale-in.
FUSION_REGIME_MAX_RANGE_BPS=45
# Reject flat samples that do not carry enough directional information.
FUSION_REGIME_MIN_ABS_MOVE_BPS=1.5
# Reject repeated direction flips and weak trend consistency.
FUSION_REGIME_MAX_FLIP_RATIO=0.60
FUSION_REGIME_MIN_DIRECTION_CONSISTENCY=0.60

# Optional external prediction feeds.
# TradingView can POST JSON to /feeds/tradingview or /feeds/prediction.
# CryptoQuant can POST JSON to /feeds/cryptoquant or use EXTERNAL_POLL_URL.
EXTERNAL_POLL_URL=
EXTERNAL_POLL_API_KEY=
EXTERNAL_POLL_SOURCE=cryptoquant
EXTERNAL_POLL_INTERVAL_SEC=5
EXTERNAL_PROBABILITY_JSON_PATH=probability_up
EXTERNAL_CONFIDENCE_JSON_PATH=confidence
# Replace with a random secret of at least 16 characters in Railway Variables.
# Write APIs remain disabled while this value is blank or change-me.
WEBHOOK_SECRET=change-me

# Deployment.
ENABLE_API=true
