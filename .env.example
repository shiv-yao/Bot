# Safe default: paper trading. Change LIVE_TRADING only after paper validation.
APP_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Polymarket CLOB V2
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
PK=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
SIGNATURE_TYPE=0
FUNDER_ADDRESS=
YES_TOKEN_ID=
NO_TOKEN_ID=
CONDITION_ID=
TICK_SIZE=0.01
NEG_RISK=false

# Safety
LIVE_TRADING=false
LIVE_CONFIRMATION=
ACCOUNT_EQUITY_USD=1000
MAX_ORDER_EQUITY_FRACTION=0.005
MAX_DAILY_LOSS_FRACTION=0.02
MAX_OPEN_NOTIONAL_USD=50
MIN_EDGE=0.003
MIN_CONFIDENCE=0.55
SIGNAL_COOLDOWN_MS=250
MAX_SIGNAL_AGE_MS=1000
ORDER_TIMEOUT_MS=1500
MAX_QUEUE_SIZE=10000
EXECUTION_WORKERS=8
ORDER_RATE_PER_SEC=70
ORDER_BURST=350

# WebSockets
MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
RTDS_WS_URL=wss://ws-live-data.polymarket.com

# Optional external prediction feeds.
# TradingView should POST JSON to /feeds/prediction.
# CryptoQuant or another provider may be polled through a JSON endpoint.
EXTERNAL_POLL_URL=
EXTERNAL_POLL_API_KEY=
EXTERNAL_POLL_SOURCE=cryptoquant
EXTERNAL_POLL_INTERVAL_SEC=5
EXTERNAL_PROBABILITY_JSON_PATH=probability_up
EXTERNAL_CONFIDENCE_JSON_PATH=confidence
WEBHOOK_SECRET=change-me

# Deployment
ENABLE_API=true
